# IAS2 Commerce — production hardening (InfinityFree / Apache)

# Serve index.html for directory requests, block directory listings
DirectoryIndex index.html
Options -Indexes

# ============================================================
# Content-Security-Policy (mirror of the <meta> tag in index.html):
# everything same-origin, no inline script, no inline styles,
# no third-party code, no frames, no form hijacking.
# ============================================================
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Never let the browser guess content types (blocks MIME confusion attacks)
  Header always set X-Content-Type-Options "nosniff"

  # Anti-clickjacking: only our own origin may frame us
  Header always set X-Frame-Options "SAMEORIGIN"

  # Don't leak full URLs to other origins via Referer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features the store doesn't use (and attackers could abuse)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Isolate the browsing context (Spectre-class mitigations)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Cache policy: HTML stays fresh so new deploys appear immediately.
  # JS/CSS are content-fingerprinted at build time (?v=<hash> on every
  # reference, see tools/fingerprint.mjs), so their URLs change whenever
  # content changes — they can be cached as effectively immutable.
  # Images and SVGs are referenced by runtime-constructed URLs that the
  # build cannot fingerprint, so they keep a modest 1-hour lifetime.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # EXCEPTION — js/modules/state.js is referenced WITHOUT a fingerprint
  # (ESM module identity requires a bare specifier, see tools/fingerprint.mjs),
  # so it must always be revalidated or browsers would keep a stale copy for
  # a year after a deploy that changed it. Keep this AFTER the rule above.
  <FilesMatch "^state\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|jpg|jpeg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Never serve the export backup with forgiving content types
  <FilesMatch "\.json$">
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Disposition "attachment"
  </FilesMatch>

  # Source maps and internal docs should never ship to the web root
  <FilesMatch "\.(map|md|log|bak)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Friendly 404 page instead of the hosting default
ErrorDocument 404 /404.html

# Force HTTPS if the host is not local (InfinityFree injects its own
# HSTS header when the free SSL is active, so we don't add a duplicate)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
